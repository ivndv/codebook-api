# Variables de entorno de codebook-api
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore.

# Clave de Groq → https://console.groq.com/keys
GROQ_API_KEY=

# Secreto compartido con el front (lo manda en el header X-API-Key)
CODEBOOK_API_KEY=

# Modelo de Groq (compatible con el SDK de OpenAI)
GROQ_MODEL=openai/gpt-oss-20b

# CORS: orígenes permitidos, separados por coma
ALLOWED_ORIGINS=http://localhost:3000
