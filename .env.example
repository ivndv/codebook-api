# Variables de entorno de codebook-api
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore.

# Clave de la IA → https://console.groq.com/keys
GROQ_API_KEY=

# Secreto compartido con el front (lo manda en el header X-API-Key)
CODEBOOK_API_KEY=

# Proveedor de IA (compatible con el SDK de OpenAI)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# CORS: orígenes permitidos, separados por coma
ALLOWED_ORIGINS=http://localhost:3000
